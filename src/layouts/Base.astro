---
import land from '../config/land.json';
const { titel, beschreibung, noindex = false, pfad = Astro.url.pathname } = Astro.props;
const canonical = new URL(pfad, Astro.site).href;
---
<!doctype html>
<html lang={land.sprache}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titel}</title>
  <meta name="description" content={beschreibung} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <style>
    body{font:16px/1.55 system-ui,sans-serif;color:#1d2330;margin:0;background:#fff}
    main,header,footer{max-width:60rem;margin:0 auto;padding:1rem}
    a{color:#0b5cad} footer{border-top:1px solid #dde2ea;font-size:.9rem;color:#4a5568}
  </style>
</head>
<body>
  <header><a href="/">{land.name}</a></header>
  <main><slot /></main>
  <footer><a href="/methodik/">So entstehen unsere Daten</a> · <a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a></footer>
</body>
</html>
