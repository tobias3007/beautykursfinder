---
import Base from '../layouts/Base.astro';
import { anbieter, kursarten, stadtSeiten, staedte, preise, preisStat, eur, datum, datenstand, imAngebot, feldWert } from '../lib/daten.js';
const nStadt = new Set(anbieter.map((a) => a.stadt.wert)).size;
const mitPreis = anbieter.filter((a) => a.kurse.some((k) => feldWert(k.preis) !== null)).length;
const stadtListe = staedte.map((s) => ({ s, n: anbieter.filter((a) => a.stadt.wert === s.name).length, seiten: stadtSeiten.filter((x) => x.stadt.slug === s.slug) })).filter((x) => x.seiten.length > 0).sort((a, b) => b.n - a.n);
---
<Base titel="Beauty-Schulungen vergleichen | Beautykursfinder" beschreibung={`${anbieter.length} Anbieter von Wimpern-, PMU- und Microblading-Schulungen in ${nStadt} deutschen Großstädten mit Preisen, Datenstand ${datum(datenstand)}.`}>
  <h1>Beauty-Schulungen in deutschen Großstädten vergleichen</h1>
  <p class="antwort">{anbieter.length} Anbieter von Schulungen zu Wimpernverlängerung, Wimpernlifting, Permanent Make-up und Microblading in {nStadt} Städten, alle Angaben von den Webseiten der Anbieter, Stand {datum(datenstand)}. Bei {mitPreis} von {anbieter.length} haben wir dort einen Preis gefunden. Wir zeigen ihn, wo er steht, und sagen es, wo nicht.</p>
  <h2>Was möchtest du lernen?</h2>
  <ul class="kacheln">{kursarten.map((k) => { const s = preisStat(preise(k.id)); return <li><a class="kachel" href={`/${k.slug}/`}><img src={`/img/kursart-${k.id}.svg`} width="56" height="56" alt="" loading="lazy" decoding="async" /><strong>{k.name}</strong><span>{imAngebot(k.id).length} Anbieter</span>{s && <span>Preise von {eur(s.min)} bis {eur(s.max)}, mittlerer Einstieg {eur(s.median)}</span>}</a></li>; })}</ul>
  <h2>In welcher Stadt?</h2>
  <p class="stand">Städte mit mindestens drei Anbietern je Kursart. Wähle Stadt und Kursart.</p>
  <ul class="kacheln">{stadtListe.map(({ s, n, seiten }) => <li><div class="kachel"><strong>{s.name}</strong><span>{n} Anbieter erfasst</span><span>{seiten.map((x, i) => <>{i > 0 && ' · '}<a href={`/${x.kursart.slug}/${s.slug}/`}>{x.kursart.name.replace('Wimpernverlängerung', 'Wimpern').replace('Wimpernlifting', 'Lifting').replace('Permanent Make-up', 'PMU')}</a></>)}</span></div></li>)}</ul>
  <h2>Preise im Überblick</h2>
  <ul class="chips">{kursarten.map((k) => <li><a href={`/preise/${k.slug}/`}>Preise {k.name}</a></li>)}</ul>
  <p class="hinweis"><strong>Du bietest Schulungen an?</strong> Schreibe uns an <a href="mailto:office@neolime.io?subject=Eintrag%20%C3%A4ndern%20oder%20%C3%BCbernehmen">office@neolime.io</a>, wenn ein Eintrag nicht stimmt oder du ihn übernehmen möchtest. <a href="/methodik/">So entstehen unsere Daten.</a></p>
</Base>
