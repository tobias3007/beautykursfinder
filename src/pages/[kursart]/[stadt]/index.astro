---
import Base from '../../../layouts/Base.astro';
import AnbieterKarte from '../../../components/AnbieterKarte.astro';
import { hatSubstanz, stadtSeiten, preisStat, eur, datum, datenstand, feldWert, kursVon, sortiere } from '../../../lib/daten.js';
export function getStaticPaths() { return stadtSeiten.map((x) => ({ params: { kursart: x.kursart.slug, stadt: x.stadt.slug }, props: x })); }
const { kursart: k, stadt, liste } = Astro.props;
const sortiert = sortiere(liste, k.id);
const mitPreis = liste.map((a) => ({ a, k: kursVon(a, k.id) })).filter((x) => feldWert(x.k.preis));
const s = preisStat(mitPreis);
const titel = `${k.name}-Schulung ${stadt.name}: ${liste.length} Anbieter`;
const seite = new URL(`/${k.slug}/${stadt.slug}/`, Astro.site).href;
const kurse = sortiert.map((a, i) => {
  const url = hatSubstanz(a) ? new URL(`/anbieter/${a.id}/`, Astro.site).href : `${seite}#${a.id}`;
  return { '@type': 'ListItem', position: i + 1, url, item: { '@type': 'Course', name: `${k.name}-Schulung bei ${a.name.wert}`, description: `${k.name}-Schulung bei ${a.name.wert}, ${stadt.name}.`, url, provider: { '@type': 'Organization', name: a.name.wert, sameAs: a.webseite.wert } } };
});
const jl = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: `${k.name}-Schulungen in ${stadt.name}`, itemListElement: kurse }];
---
<Base titel={titel} beschreibung={`In ${stadt.name} bieten ${liste.length} Anbieter ${k.name}-Schulungen an${s ? `, Preise ${eur(s.min)} bis ${eur(s.max)}` : ''}. Stand ${datum(datenstand)}.`} krumen={[{ name: `${k.name}-Schulung`, href: `/${k.slug}/` }, { name: stadt.name, href: `/${k.slug}/${stadt.slug}/` }]} jsonld={jl}>
  <h1>{k.name}-Schulung in {stadt.name}</h1>
  <p class="antwort">In {stadt.name} bieten {liste.length} Anbieter eine {k.name}-Schulung an.{s ? ` ${s.n} von ihnen nennen einen Preis, er liegt zwischen ${eur(s.min)} und ${eur(s.max)}.` : ' Keiner dieser Anbieter nennt auf seiner Webseite einen Preis.'} Stand {datum(datenstand)}, Quelle: die Webseiten der Anbieter. Was nicht dasteht, haben wir nicht ergänzt.</p>
  <div class="filter" role="group" aria-label="Anbieter filtern">
    <label><input type="checkbox" id="f-preis" /> Nur mit Preis</label>
    <label><input type="checkbox" id="f-zert" /> Nur mit Zertifikat</label>
  </div>
  <div class="karten">{sortiert.map((a) => <AnbieterKarte a={a} k={kursVon(a, k.id)} kontext={`stadt-${stadt.slug}`} />)}</div>
  <p class="stand">Preise so, wie der Anbieter sie nennt, brutto oder netto je nach Anbieter. „Zertifikat“ meint die Bescheinigung, die der Anbieter selbst nennt. <a href={`/preise/${k.slug}/`}>Preisübersicht {k.name}</a> · <a href={`/${k.slug}/`}>Alle Städte</a></p>
</Base>
