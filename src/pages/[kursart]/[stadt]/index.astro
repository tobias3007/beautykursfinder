---
import Base from '../../../layouts/Base.astro';
import { stadtSeiten, preisStat, eur, datum, datenstand, auf, preisText, feldWert, kursVon, config } from '../../../lib/daten.js';
export function getStaticPaths() { return stadtSeiten.map((x) => ({ params: { kursart: x.kursart.slug, stadt: x.stadt.slug }, props: x })); }
const { kursart: k, stadt, liste } = Astro.props;
const mitPreis = liste.map((a) => ({ a, k: kursVon(a, k.id) })).filter((x) => feldWert(x.k.preis));
const s = preisStat(mitPreis);
const titel = `${k.name}-Schulung ${stadt.name}: ${liste.length} Anbieter`;
const kurse = liste.slice(0).map((a) => ({ '@type': 'ListItem', position: 0, item: { '@type': 'Course', name: `${k.name}-Schulung`, description: `${k.name}-Schulung von ${a.name.wert} in ${stadt.name}.`, provider: { '@type': 'Organization', name: a.name.wert, sameAs: a.webseite.wert } } })).map((x, i) => ({ ...x, position: i + 1 }));
const jl = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: `${k.name}-Schulungen in ${stadt.name}`, itemListElement: kurse }];
---
<Base titel={titel} beschreibung={`In ${stadt.name} bieten ${liste.length} Anbieter ${k.name}-Schulungen an${s ? `, Preise ${eur(s.min)} bis ${eur(s.max)}` : ''}. Stand ${datum(datenstand)}.`} krumen={[{ name: `${k.name}-Schulung`, href: `/${k.slug}/` }, { name: stadt.name, href: `/${k.slug}/${stadt.slug}/` }]} jsonld={jl}>
  <h1>{k.name}-Schulung in {stadt.name}</h1>
  <p class="antwort">In {stadt.name} bieten {liste.length} Anbieter eine {k.name}-Schulung an.{s ? ` ${s.n} von ihnen nennen einen Preis, er liegt zwischen ${eur(s.min)} und ${eur(s.max)}.` : ' Keiner dieser Anbieter nennt auf seiner Webseite einen Preis.'} Stand {datum(datenstand)}, Quelle: die Webseiten der Anbieter.</p>
  <table>
    <thead><tr><th>Anbieter</th><th>Preis</th><th>Dauer</th><th>Gruppe</th><th>Zertifikat</th><th>Termine</th></tr></thead>
    <tbody>{liste.map((a) => { const c = kursVon(a, k.id); return <tr>
      <th scope="row"><a href={`/anbieter/${a.id}/`}>{a.name.wert}</a></th>
      <td>{preisText(c.preis)}</td><td>{auf(c.dauer)}</td>
      <td>{auf(c.gruppengroesse, (n) => `max. ${n}`)}</td><td>{feldWert(c.zertifikat) ? 'laut Anbieter' : 'auf Anfrage'}</td><td>auf Anfrage</td></tr>; })}</tbody>
  </table>
  <p>Weitere Kursarten in {stadt.name} und andere Städte: <a href={`/${k.slug}/`}>alle Städte für {k.name}</a>.</p>
</Base>
